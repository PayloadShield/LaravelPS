{
    "name": "payloadshield/laravelps",
    "description": "Pluggable Laravel middleware for encrypting/decrypting request and response payloads.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "laravel",
        "crypto",
        "encryption",
        "payloadshield",
        "middleware"
    ],
    "homepage": "https://github.com/PayloadShield/LaravelPS",
    "authors": [
        {
            "name": "Ganesh Kandu",
            "email": "kanduganesh@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0",
        "illuminate/routing": "^10.0 || ^11.0 || ^12.0",
        "payloadshield/comphpps": "@dev"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "PayloadShield\\LaravelPS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PayloadShield\\LaravelPS\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PayloadShield\\LaravelPS\\PayloadShieldServiceProvider"
            ],
            "aliases": {
                "PayloadShield": "PayloadShield\\LaravelPS\\Facades\\PayloadShield"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}